msgid ""
"Connection failed: OIDC discovery endpoint not found (404). Check if the "
"base URL is correct."
msgstr ""
"La connexió ha fallat: no s'ha trobat el punt de descoberta OIDC (404). "
"Comproveu si l'adreça URL de base és correcta."

#: cps/admin.py
#, python-format
msgid "Connection failed: Server returned status code %(code)s"
msgstr ""
"La connexió ha fallat: el servidor ha retornat el codi d'estat %(code)s"

