#: cps/about.py cps/spa_strings.py
msgid "Statistics"
msgstr "Estadístiques"

#: cps/admin.py
msgid "Calibre database unavailable. Please reconfigure the library path."
msgstr ""
"La base de dades Calibre no està disponible. Torneu a configurar el camí de "
"la biblioteca."

#: cps/admin.py
msgid "Server restarted, please reload page."
msgstr "S'ha reiniciat el servidor. Torneu a carregar la pàgina."

#: cps/admin.py
msgid "Performing Server shutdown, please close window."
msgstr "S'està aturant el servidor. Tanqueu la finestra."

#: cps/admin.py
msgid "Success! Database Reconnected"
msgstr "S'ha restablert la connexió amb la base de dades."

#: cps/admin.py
msgid "Unknown command"
msgstr "Ordre desconeguda"

#: cps/admin.py
msgid ""
"Success! Books queued for Metadata Backup, please check Tasks for result"
msgstr ""
"Els llibres s'han posat a la cua per a la còpia de seguretat de les "
"metadades. Comproveu-ne el resultat a Tasques."

#: cps/admin.py
msgid ""
"Error: Hardcover sync is disabled. Enable it in Basic Configuration or with "
"HARDCOVER_SYNC_ENABLED."
msgstr ""
"Error: la sincronització amb Hardcover és desactivada. Activeu-la a "
"Configuració bàsica o amb HARDCOVER_SYNC_ENABLED."

#: cps/admin.py
msgid ""
"Error: No Hardcover token available. Set HARDCOVER_TOKEN environment "
"variable or configure in Basic Configuration."
msgstr ""
"Error: no hi ha cap testimoni de Hardcover. Definiu la variable d'entorn "
"HARDCOVER_TOKEN o configureu-lo a Configuració bàsica."

#: cps/admin.py
msgid ""
"Success! Hardcover auto-fetch task started. Check Tasks panel for progress."
msgstr ""
"S'ha iniciat la tasca de cerca automàtica a Hardcover. Consulteu-ne el "
"progrés a Tasques."

#: cps/admin.py
#, python-format
msgid "Error starting Hardcover auto-fetch task: %(error)s"
msgstr "Error en iniciar la tasca de cerca automàtica a Hardcover: %(error)s"

#: cps/admin.py cps/templates/admin.html
msgid "Review Hardcover Matches"
msgstr "Revisa les coincidències de Hardcover"

#: cps/admin.py
#, python-format
msgid "Error loading review queue: %(error)s"
msgstr "Error en carregar la cua de revisió: %(error)s"

#: cps/admin.py
msgid "Hardcover ID applied successfully"
msgstr "L'identificador de Hardcover s'ha aplicat correctament"

#: cps/admin.py
#, python-format
msgid "Match %(action)s"
msgstr "Coincidència: %(action)s"

#: cps/admin.py
msgid "No pending matches to reject"
msgstr "No hi ha coincidències pendents per rebutjar."

#: cps/admin.py
#, python-format
msgid "Rejected %(count)s match(es)"
msgstr "Coincidències rebutjades: %(count)s"

#: cps/admin.py
#, python-brace-format
msgid ""
"Thumbnail cache refresh started for {} book(s). This may take a few minutes."
msgstr ""
"S'ha iniciat l'actualització de la memòria cau de miniatures. Llibres: {}. "
"Pot trigar uns minuts."

#: cps/admin.py
msgid "No books with covers found to process."
msgstr "No s'han trobat llibres amb cobertes per processar."

#: cps/admin.py
#, python-brace-format
msgid "Failed to start thumbnail refresh: {}"
msgstr "No s'ha pogut iniciar l'actualització de les miniatures: {}"

#: cps/admin.py
msgid "Admin page"
msgstr "Pàgina d'administració"

#: cps/admin.py
msgid "Hardcover token expires"
msgstr "El testimoni de Hardcover caduca"

#: cps/admin.py
msgid "Basic Configuration"
msgstr "Configuració bàsica"

#: cps/admin.py
msgid "UI Configuration"
msgstr "Configuració de la IU"

#: cps/admin.py cps/db.py cps/search.py cps/web.py
#, python-format
msgid "Custom Column No.%(column)d does not exist in calibre database"
msgstr ""
"La columna personalitzada núm. %(column)d no existeix a la base de dades de "
"Calibre."

#: cps/admin.py cps/templates/admin.html
msgid "Edit Users"
msgstr "Edita usuaris"

#: cps/admin.py cps/opds.py cps/spa_strings.py cps/templates/grid.html
#: cps/templates/index.html cps/templates/list.html
msgid "All"
msgstr "Tots"

#: cps/admin.py
msgid "User not found"
msgstr "No s'ha trobat l'usuari"

#: cps/admin.py
#, python-brace-format
msgid "{} users deleted successfully"
msgstr "Usuaris suprimits: {}"

#: cps/admin.py cps/api/options.py cps/templates/config_view_edit.html
#: cps/templates/user_edit.html cps/templates/user_table.html
msgid "Show All"
msgstr "Mostra-ho tot"

#: cps/admin.py
msgid "Malformed request"
msgstr "Sol·licitud mal formada"

#: cps/admin.py
msgid "Guest Name can't be changed"
msgstr "El nom del convidat no es pot canviar"

#: cps/admin.py
msgid "Guest can't have this role"
msgstr "El convidat no pot tenir aquest rol."

#: cps/admin.py
msgid "No admin user remaining, can't remove admin role"
msgstr "No queda cap administrador; no es pot retirar el rol d'administrador."

#: cps/admin.py
msgid "Value has to be true or false"
msgstr "El valor ha de ser vertader o fals"

#: cps/admin.py
msgid "Invalid role"
msgstr "Rol no vàlid"

#: cps/admin.py
msgid "Guest can't have this view"
msgstr "El convidat no pot tenir aquesta vista"

#: cps/admin.py
msgid "Invalid view"
msgstr "Vista no vàlida"

#: cps/admin.py
msgid "Guest's Locale is determined automatically and can't be set"
msgstr ""
"La configuració regional del convidat es determina automàticament i no es "
"pot canviar."

#: cps/admin.py
msgid "No Valid Locale Given"
msgstr "No s'ha indicat cap configuració regional vàlida."

#: cps/admin.py
msgid "No Valid Book Language Given"
msgstr "No s'ha indicat cap idioma vàlid per als llibres."

#: cps/admin.py cps/editbooks.py
msgid "Parameter not found"
msgstr "No s'ha trobat el paràmetre"

#: cps/admin.py
msgid "Settings DB is not Writeable"
msgstr "No es pot escriure a la base de dades de configuració."

#: cps/admin.py
#, python-format
msgid "Invalid OPDS filename template: %(error)s"
msgstr "Plantilla de nom de fitxer OPDS no vàlida: %(error)s"

#: cps/admin.py
msgid ""
"Cannot select this Boolean column until incompatible global and user "
"restrictions are corrected or cleared."
msgstr ""
"No es pot seleccionar aquesta columna booleana fins que les restriccions "
"globals i d'usuari incompatibles no es corregin o s'esborrin."

#: cps/admin.py
msgid ""
"Support settings were not saved. Use an HTTP or HTTPS URL without "
"credentials, with a URL up to 2048 characters and a label up to 80 "
"characters."
msgstr ""
"La configuració d'assistència no s'ha desat. Feu servir una URL HTTP o HTTPS"
" sense credencials, de 2.048 caràcters com a màxim, i una etiqueta de 80 "
"caràcters com a màxim."

#: cps/admin.py
msgid "Invalid default body font option"
msgstr ""
"L'opció de tipus de lletra predeterminat del cos del text no és vàlida."

#: cps/admin.py
msgid "Invalid default display font option"
msgstr ""
"L'opció de tipus de lletra predeterminat de la interfície no és vàlida."

#: cps/admin.py
msgid "Invalid Read Column"
msgstr "Columna de lectura no vàlida"

#: cps/admin.py
msgid "Invalid Restricted Column"
msgstr "Columna restringida no vàlida"

#: cps/admin.py
msgid ""
"The title-sort rule was saved, but reordering the existing library failed — "
"books may keep their previous order until you retry or edit them."
msgstr ""
"S'ha desat la regla d'ordenació dels títols, però no s'ha pogut reordenar la"
" biblioteca. Els llibres poden mantenir l'ordre anterior fins que torneu a "
"provar l'ordenació o els editeu."

#: cps/admin.py
msgid "Calibre-Web NextGen configuration updated"
msgstr "S'ha actualitzat la configuració de Calibre-Web NextGen"

#: cps/admin.py
msgid "Do you really want to delete the Kobo Token?"
msgstr "Esteu segur que voleu suprimir el testimoni de Kobo?"

#: cps/admin.py
msgid "Do you really want to delete this domain?"
msgstr "Esteu segur que voleu suprimir aquest domini?"

#: cps/admin.py
msgid "Do you really want to delete this user?"
msgstr "Esteu segur que voleu suprimir aquest usuari?"

#: cps/admin.py
msgid "Are you sure you want to delete this shelf?"
msgstr "Esteu segur que voleu suprimir aquest prestatge?"

#: cps/admin.py
msgid "Are you sure you want to change locales of selected user(s)?"
msgstr ""
"Esteu segur que voleu canviar la configuració regional dels usuaris "
"seleccionats?"

#: cps/admin.py
msgid ""
"Are you sure you want to change visible book languages for selected user(s)?"
msgstr ""
"Esteu segur que voleu canviar els idiomes visibles dels llibres per als "
"usuaris seleccionats?"

#: cps/admin.py
msgid ""
"Are you sure you want to change the selected role for the selected user(s)?"
msgstr "Esteu segur que voleu canviar el rol dels usuaris seleccionats?"

#: cps/admin.py
msgid ""
"Are you sure you want to change the selected restrictions for the selected "
"user(s)?"
msgstr ""
"Esteu segur que voleu canviar les restriccions seleccionades per als usuaris"
" seleccionats?"

#: cps/admin.py
msgid ""
"Are you sure you want to change the selected visibility restrictions for the"
" selected user(s)?"
msgstr ""
"Esteu segur que voleu canviar les restriccions de visibilitat seleccionades "
"per als usuaris seleccionats?"

#: cps/admin.py
msgid ""
"Are you sure you want to change shelf sync behavior for the selected "
"user(s)?"
msgstr ""
"Esteu segur que voleu canviar el comportament de sincronització de "
"prestatges per als usuaris seleccionats?"

#: cps/admin.py
msgid ""
"Are you sure you want to change OPDS shelf exposure for the selected "
"user(s)?"
msgstr ""
"Esteu segur que voleu canviar la visibilitat dels prestatges a OPDS per als "
"usuaris seleccionats?"

#: cps/admin.py
msgid "Are you sure you want to change Calibre library location?"
msgstr ""
"Esteu segur que voleu canviar la ubicació de la biblioteca de Calibre?"

#: cps/admin.py
msgid ""
"Calibre-Web NextGen will search for updated Covers and update Cover "
"Thumbnails, this may take a while?"
msgstr ""
"Calibre-Web NextGen cercarà cobertes actualitzades i en renovarà les "
"miniatures. L'operació pot trigar una estona. Voleu continuar?"

#: cps/admin.py
msgid ""
"Are you sure you want delete Calibre-Web NextGen's sync database to force a "
"full sync with your Kobo Reader?"
msgstr ""
"Esteu segur que voleu suprimir la base de dades de sincronització de "
"Calibre-Web NextGen per forçar una sincronització completa amb el vostre "
"Kobo Reader?"

#: cps/admin.py cps/spa_strings.py cps/templates/modal_dialogs.html
#: cps/templates/user_table.html
msgid "Deny"
msgstr "Denega"

#: cps/admin.py cps/templates/modal_dialogs.html cps/templates/user_table.html
msgid "Allow"
msgstr "Permet"

#: cps/admin.py
#, python-brace-format
msgid "{} sync entries deleted"
msgstr "S'han suprimit {} entrades de sincronització"

#: cps/admin.py
#, python-brace-format
msgid "Book {} not found"
msgstr "No s'ha trobat el llibre {}"

#: cps/admin.py
#, python-brace-format
msgid ""
"Cleared sync state for book {0} (user {1}); the device will re-receive the "
"book on next sync"
msgstr ""
"S'ha esborrat l'estat de sincronització del llibre {0} (usuari {1}); el "
"dispositiu tornarà a rebre el llibre la propera sincronització"

#: cps/admin.py
#, python-brace-format
msgid ""
"Book {0} was not in the sync record for user {1}; the device will receive it"
" on next sync"
msgstr ""
"El llibre {0} no estava al registre de sincronització de l'usuari {1}; el "
"dispositiu el rebrà a la propera sincronització"

#: cps/admin.py cps/templates/kobo_reconcile.html
#, python-format
msgid "Reconcile deleted Kobo books for %(user)s"
msgstr "Reconcilia els llibres de Kobo suprimits per a %(user)s"

#: cps/admin.py
msgid "Choose a KoboReader.sqlite file."
msgstr "Trieu un fitxer KoboReader.sqlite."

#: cps/admin.py
msgid "The uploaded file is not a SQLite database."
msgstr "El fitxer penjat no és una base de dades SQLite."

#: cps/admin.py
#, python-format
msgid "The file is larger than %(max)d MB."
msgstr "El fitxer és més gran que %(max)d MB."

#: cps/admin.py
msgid "This preview is invalid or expired. Upload the device database again."
msgstr ""
"Aquesta previsualització no és vàlida o ha caducat. Torneu a penjar la base "
"de dades del dispositiu."

#: cps/admin.py
msgid "Select at least one book to archive."
msgstr "Seleccioneu almenys un llibre per arxivar."

#: cps/admin.py
msgid ""
"The selected books do not match this preview. Upload the device database "
"again."
msgstr ""
"Els llibres seleccionats no coincideixen amb aquesta previsualització. "
"Torneu a penjar la base de dades del dispositiu."

#: cps/admin.py
msgid "Boolean restrictions must be Yes, No, or Undefined."
msgstr "Les restriccions booleanes han de ser Sí, No o Sense definir."

#: cps/admin.py cps/api/browse.py cps/spa_strings.py
msgid "Tag not found"
msgstr "No s'ha trobat l'etiqueta"

#: cps/admin.py
msgid "Invalid Action"
msgstr "Acció no vàlida"

#: cps/admin.py
msgid "client_secrets.json Is Not Configured For Web Application"
msgstr "client_secrets.json no està configurat per a l'aplicació web."

#: cps/admin.py
msgid "Logfile Location is not Valid, Please Enter Correct Path"
msgstr ""
"La ubicació del fitxer de registre no és vàlida. Introduïu el camí correcte."

#: cps/admin.py
msgid "Access Logfile Location is not Valid, Please Enter Correct Path"
msgstr ""
"La ubicació del fitxer de registre d'accés no és vàlida. Introduïu el camí "
"correcte."

#: cps/admin.py
msgid "Please Enter a LDAP Provider, Port, DN and User Object Identifier"
msgstr ""
"Introduïu el proveïdor LDAP, el port, el DN i l'identificador d'objecte "
"d'usuari."

#: cps/admin.py
msgid "Please Enter a LDAP Service Account and Password"
msgstr "Introduïu un compte de servei i una contrasenya LDAP"

#: cps/admin.py
msgid "Please Enter a LDAP Service Account"
msgstr "Introduïu un compte de servei LDAP"

#: cps/admin.py
#, python-format
msgid "LDAP Group Object Filter Needs to Have One \"%s\" Format Identifier"
msgstr ""
"El filtre d'objectes de grup LDAP ha de tenir un identificador de format "
"\"%s\""

#: cps/admin.py
msgid "LDAP Group Object Filter Has Unmatched Parenthesis"
msgstr "El filtre d’objectes de grup LDAP conté parèntesis sense parella."

#: cps/admin.py
#, python-format
msgid "LDAP User Object Filter needs to Have One \"%s\" Format Identifier"
msgstr ""
"El filtre d'objectes d'usuari LDAP ha de tenir un identificador de format "
"\"%s\""

#: cps/admin.py
msgid "LDAP User Object Filter Has Unmatched Parenthesis"
msgstr "El filtre d'objectes d'usuari LDAP conté parèntesis sense parella."

#: cps/admin.py
#, python-format
msgid "LDAP Member User Filter needs to Have One \"%s\" Format Identifier"
msgstr ""
"El filtre d'usuari membre LDAP ha de tenir un identificador de format \"%s\""

#: cps/admin.py
msgid "LDAP Member User Filter Has Unmatched Parenthesis"
msgstr "El filtre d'usuari membre LDAP conté parèntesis sense parella."

#: cps/admin.py
msgid ""
"LDAP CACertificate, Certificate or Key Location is not Valid, Please Enter "
"Correct Path"
msgstr ""
"La ubicació del certificat de CA, el certificat o la clau LDAP no és vàlida."
" Introduïu el camí correcte."

#: cps/admin.py cps/templates/admin.html
msgid "Add New User"
msgstr "Afegeix un usuari nou"

#: cps/admin.py cps/templates/admin.html cps/templates/broadcast_email.html
msgid "Edit Email Server Settings"
msgstr "Edita la configuració del servidor de correu electrònic"

#: cps/admin.py
msgid "Success! Gmail Account Verified."
msgstr "S'ha verificat el compte de Gmail."

#: cps/admin.py cps/editbooks.py cps/shelf.py cps/tasks/convert.py cps/web.py
#, python-format
msgid "Oops! Database Error: %(error)s."
msgstr "Error de la base de dades: %(error)s"

#: cps/admin.py
#, python-format
msgid ""
"Test e-mail queued for sending to %(email)s, please check Tasks for result"
msgstr ""
"El correu electrònic de prova s’ha posat a la cua per a %(email)s. "
"Comproveu-ne el resultat a Tasques."

#: cps/admin.py
#, python-format
msgid "There was an error sending the Test e-mail: %(res)s"
msgstr ""
"S'ha produït un error en enviar el correu electrònic de prova: %(res)s"

#: cps/admin.py
msgid "Please configure your e-mail address first..."
msgstr "Configureu primer la vostra adreça de correu electrònic..."

#: cps/admin.py
msgid "Email Server Settings updated"
msgstr "S'ha actualitzat la configuració del servidor de correu electrònic"

#: cps/admin.py cps/templates/admin.html
msgid "Email Your Users"
msgstr "Envia un correu als usuaris"

#: cps/admin.py
msgid ""
"Please configure the email server under Edit Email Server Settings first."
msgstr ""
"Configureu primer el servidor de correu a «Edita la configuració del "
"servidor de correu electrònic»."

#: cps/admin.py
msgid "Please enter a subject for the announcement email."
msgstr "Introduïu un assumpte per al correu electrònic de l'anunci."

#: cps/admin.py
msgid "Please enter a message body for the announcement email."
msgstr "Introduïu el cos del missatge per al correu electrònic de l'anunci."

#: cps/admin.py
msgid "Please set an email address on your own account first..."
msgstr ""
"Primer, configureu una adreça de correu electrònic al vostre compte..."

#: cps/admin.py
msgid "Please select at least one recipient."
msgstr "Seleccioneu almenys un destinatari."

#: cps/admin.py
msgid "No valid recipients — nothing was sent."
msgstr "No hi ha destinataris vàlids; no s’ha enviat res."

#: cps/admin.py
#, python-format
msgid ""
"Test announcement email queued to %(email)s — check Tasks for the result."
msgstr ""
"El correu de prova de l'anunci s'ha posat a la cua per a %(email)s. "
"Comproveu-ne el resultat a Tasques."

#: cps/admin.py
#, python-format
msgid ""
"Announcement email queued for %(num)s recipient(s) — check Tasks for "
"delivery."
msgstr ""
"L’anunci s’ha posat a la cua per a %(num)s destinataris. Comproveu-ne el "
"lliurament a Tasques."

#: cps/admin.py
#, python-format
msgid "%(num)s address(es) were skipped as invalid or duplicate."
msgstr "Adreces omeses perquè no són vàlides o estan duplicades: %(num)s."

#: cps/admin.py cps/templates/admin.html
msgid "Edit Scheduled Tasks Settings"
msgstr "Edita la configuració de les tasques programades"

#: cps/admin.py
msgid "Invalid start time for task specified"
msgstr "L'hora d'inici de la tasca especificada no és vàlida"

#: cps/admin.py
msgid "Invalid duration for task specified"
msgstr "La durada de la tasca especificada no és vàlida"

#: cps/admin.py
msgid "Scheduled tasks settings updated"
msgstr "S'ha actualitzat la configuració de les tasques programades"

#: cps/admin.py cps/web.py
msgid "Oops! An unknown error occurred. Please try again later."
msgstr "S'ha produït un error desconegut. Torneu-ho a provar més tard."

#: cps/admin.py cps/opds.py cps/web.py
msgid "title"
msgstr "Títol"

#: cps/admin.py
#, python-format
msgid "Edit User %(nick)s"
msgstr "Edita l'usuari %(nick)s"

#: cps/admin.py
#, python-format
msgid "Success! Password for user %(user)s reset"
msgstr "S'ha restablert la contrasenya de l'usuari %(user)s."

#: cps/admin.py
msgid "Oops! Please configure the SMTP mail settings."
msgstr "Configureu el correu SMTP."

#: cps/admin.py
msgid "Logfile viewer"
msgstr "Visor de fitxers de registre"

#: cps/admin.py
msgid "Requesting update package"
msgstr "S'està sol·licitant el paquet d'actualització."

#: cps/admin.py
msgid "Downloading update package"
msgstr "S'està baixant el paquet d'actualització"

#: cps/admin.py
msgid "Unzipping update package"
msgstr "S'està descomprimint el paquet d'actualització."

#: cps/admin.py
msgid "Replacing files"
msgstr "S'estan substituint els fitxers."

#: cps/admin.py
msgid "Database connections are closed"
msgstr "Les connexions de la base de dades estan tancades"

#: cps/admin.py
msgid "Stopping server"
msgstr "S'està aturant el servidor"

#: cps/admin.py
msgid "Update finished, please press okay and reload page"
msgstr ""
"L'actualització ha finalitzat. Premeu D'acord i torneu a carregar la pàgina."

#: cps/admin.py
msgid "Update failed:"
msgstr "L'actualització ha fallat:"

#: cps/admin.py cps/updater.py
msgid "HTTP Error"
msgstr "Error HTTP"

#: cps/admin.py cps/updater.py
msgid "Connection error"
msgstr "Error de connexió"

#: cps/admin.py cps/updater.py
msgid "Timeout while establishing connection"
msgstr "S'ha esgotat el temps d'espera en establir la connexió."

#: cps/admin.py cps/updater.py
msgid "General error"
msgstr "Error general"

#: cps/admin.py
msgid "Update file could not be saved in temp dir"
msgstr "El fitxer d'actualització no s'ha pogut desar al directori temporal"

#: cps/admin.py
msgid "Files could not be replaced during update"
msgstr "Els fitxers no s'han pogut substituir durant l'actualització"

#: cps/admin.py
msgid "Failed to extract at least One LDAP User"
msgstr "No s'ha pogut extreure almenys un usuari LDAP."

#: cps/admin.py
msgid "Failed to Create at Least One LDAP User"
msgstr "No s'ha pogut crear almenys un usuari LDAP."

#: cps/admin.py
#, python-format
msgid "Error: %(ldaperror)s"
msgstr "Error: %(ldaperror)s"

#: cps/admin.py
msgid "Error: No user returned in response of LDAP server"
msgstr "Error: el servidor LDAP no ha retornat cap usuari."

#: cps/admin.py
msgid "At Least One LDAP User Not Found in Database"
msgstr "No s'ha trobat com a mínim un usuari LDAP a la base de dades"

#: cps/admin.py
#, python-brace-format
msgid "{} User Successfully Imported"
msgstr "Usuaris importats: {}"

#: cps/admin.py
msgid "Library maintenance is running; try again when it finishes."
msgstr ""
"El manteniment de la biblioteca està en marxa; torneu-ho a provar quan "
"acabi."

#: cps/admin.py
