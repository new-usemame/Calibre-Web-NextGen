msgid ""
"The managed Calibre content server requires a POSIX platform. Use the Linux "
"container on Windows."
msgstr ""
"El servidor de contingut gestionat de Calibre requereix una plataforma "
"POSIX. Utilitzeu el contenidor Linux a Windows."

#: cps/admin.py
msgid ""
"Please enter a content server username and password, or allow anonymous "
"writes"
msgstr ""
"Introduïu un nom d'usuari i una contrasenya del servidor de contingut o "
"permeteu escriptures anònimes"

#: cps/admin.py
msgid "Content server port must be a number from 1 to 65535"
msgstr "El port ha de ser un nombre entre 1 i 65535."

#: cps/admin.py
msgid "Content server port must differ from the port this server listens on"
msgstr ""
"El port del servidor de contingut ha de ser diferent del port on escolta "
"aquest servidor"

#: cps/admin.py
msgid ""
"Content server username may only use the letters A-Z, numbers, spaces, "
"underscores and hyphens"
msgstr ""
"El nom d'usuari del servidor de contingut només pot contenir lletres de l'A "
"a la Z, xifres, espais, guions baixos i guionets."

#: cps/admin.py
msgid "Content server password must use only ASCII (English) characters"
msgstr ""
"La contrasenya del servidor de contingut només ha d'utilitzar caràcters "
"ASCII (anglès)."

#: cps/admin.py
#, python-format
msgid "Invalid content server listen address: %(address)s"
msgstr "Adreça d'escolta del servidor de contingut no vàlida: %(address)s"

#: cps/admin.py
#, python-format
msgid "Invalid content server trusted IP/CIDR entry: %(entry)s"
msgstr "L’entrada IP/CIDR de confiança no és vàlida: %(entry)s."

#: cps/admin.py
msgid "Disable split library mode before enabling the Calibre content server."
msgstr ""
"Desactiveu el mode de biblioteca dividida abans d'activar el servidor de "
"contingut Calibre."

#: cps/admin.py
msgid "Keyfile Location is not Valid, Please Enter Correct Path"
msgstr ""
"La ubicació del fitxer de claus no és vàlida. Introduïu el camí correcte."

#: cps/admin.py
msgid "Certfile Location is not Valid, Please Enter Correct Path"
msgstr ""
"La ubicació del fitxer de certificat no és vàlida. Introduïu el camí "
"correcte."

