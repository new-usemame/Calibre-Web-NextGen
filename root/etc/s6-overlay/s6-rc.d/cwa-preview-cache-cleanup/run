#!/usr/bin/with-contenv bash
# shellcheck shell=bash

#------------------------------------------------------------------------------------------------------------------------
#  Cover-preview disk-cache LRU sweeper (Phase 3 of cover-normalization).
#
#  Runs the cps.services.cover_preview_cache_sweeper hourly. The sweeper
#  walks /config/.cwa-preview-cache (where the /cover/<id>/preview
#  endpoint writes padded JPEG tiles) and evicts oldest-atime files
#  until the total size is under CWA_PREVIEW_CACHE_MAX_MB (default 1024).
#
#  This is a longrun service with an inline sleep loop because s6
#  oneshot doesn't run on a timer; we want continuous hourly sweeps for
#  the lifetime of the container.
#------------------------------------------------------------------------------------------------------------------------

echo "[cwa-preview-cache-cleanup] Starting cover-preview disk-cache LRU sweeper..."

# Match localtime/TZ for log clarity, same pattern as cwa-auto-zipper.
tz=$(printcontenv TZ)
if [[ $tz == "" ]]; then
    echo "[cwa-preview-cache-cleanup] No TZ env found. Defaulting to UTC..."
else
    region=$(echo "$tz" | awk -F '/' '{ print $1 }')
    city=$(echo "$tz" | awk -F '/' '{ print $2 }')
    zoneinfo_file="/usr/share/zoneinfo/$region/$city"
    if test -f "$zoneinfo_file"; then
        ln -sfn "$zoneinfo_file" /etc/localtime
        echo "$tz" > '/etc/timezone'
        echo "[cwa-preview-cache-cleanup] Timezone set to $tz."
    else
        echo "[cwa-preview-cache-cleanup] Zoneinfo $tz not found. Using UTC."
    fi
fi

# The service body lives in scripts/services so it can run outside s6 (#2094).
# Sweeps run as abc so unlink permissions match what the web app wrote.
export CWA_RUN_AS=cwa-as-abc
exec /app/calibre-web-automated/scripts/services/cwa-preview-cache-cleanup.sh
