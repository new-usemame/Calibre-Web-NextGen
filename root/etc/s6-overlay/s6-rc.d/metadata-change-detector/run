#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "========== STARTING METADATA CHANGE DETECTOR ==========="

# The service body lives in scripts/services so it can run outside s6 (#2094).
# Only the container has the abc account, so the watch folder gets its owner here.
install -d -o abc -g abc "${CWA_METADATA_CHANGE_LOGS_DIR:-/config/metadata_change_logs}"
export CWA_RUN_AS=cwa-as-abc
exec /app/calibre-web-automated/scripts/services/metadata-change-detector.sh
