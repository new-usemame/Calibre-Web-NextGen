msgstr "Cada 4 horas"

#: cps/templates/cwa_settings.html
msgid "Every 6 Hours"
msgstr "Cada 6 horas"

#: cps/templates/cwa_settings.html
msgid "Every 12 Hours"
msgstr "Cada 12 horas"

#: cps/templates/cwa_settings.html
msgid "Daily/Weekly/Monthly"
msgstr "Diario/Semanal/Mensual"

#: cps/templates/cwa_settings.html
msgid "Daily at Specific Time"
msgstr "Diariamente a una hora específica"

#: cps/templates/cwa_settings.html
