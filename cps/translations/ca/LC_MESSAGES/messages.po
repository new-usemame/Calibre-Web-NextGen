msgstr "Té en compte el títol en detectar duplicats"

#: cps/templates/cwa_settings.html
msgid "Consider book authors when detecting duplicates"
msgstr "Té en compte l'autor en detectar duplicats"

#: cps/templates/cwa_settings.html
