#!/usr/bin/env bash
set -eu

port="${CWA_PORT_OVERRIDE:-8083}"
scheme="http"
curl_extra=()

if [[ -f /config/app.db ]]; then
  IFS=$'\t' read -r certfile keyfile <<EOF || true
$(sqlite3 -separator $'\t' /config/app.db "SELECT COALESCE(config_certfile, ''), COALESCE(config_keyfile, '') FROM settings LIMIT 1;" 2>/dev/null || true)
EOF
  if [[ -n "${certfile:-}" && -n "${keyfile:-}" && -f "$certfile" && -f "$keyfile" ]]; then
    scheme="https"
    curl_extra=(-k)
  fi
fi

# Keep the probe fail-fast and strictly bounded, while allowing scheduler and
# fork variance observed on slow ARM/VM hosts (#1799). Docker's outer 6s cap
# remains longer than curl's 5s budget and can still kill a truly dead probe.
exec curl -fsS --connect-timeout 1 --max-time 5 "${curl_extra[@]}" "${scheme}://127.0.0.1:${port}/health"
