#~ msgid ""
#~ "If your Calibre library is corrupted and cannot be opened, you can "
#~ "attempt to restore it from the OPF files in your library. This will "
#~ "<b>erase all per-book data</b> (reading progress, bookmarks, shelf links, "
#~ "downloads, etc.) in the app database, but will not affect user accounts "
