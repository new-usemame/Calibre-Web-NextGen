msgstr ""
"La connexió ha fallat: no s'ha pogut connectar al servidor. Comproveu "
"l'adreça URL i la connexió de xarxa."

#: cps/admin.py
msgid ""
"Connection failed: Request timed out. The server may be slow or unreachable."
