#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "========== STARTING CWA-INGEST SERVICE =========="

# The service body lives in scripts/services so it can run outside s6 (#2094).
# The app's config dir is /config here, as cwa-init and svc-calibre-web-automated set it.
export CALIBRE_DBPATH=/config
# Calibre children get the abc-owned, plugin-free runtime config cwa-init prepared.
export CALIBRE_CONFIG_DIRECTORY="${CALIBRE_CONFIG_DIRECTORY:-/config/.config/calibre-runtime}"
export CWA_RUN_AS=cwa-as-abc
exec /app/calibre-web-automated/scripts/services/cwa-ingest-service.sh
