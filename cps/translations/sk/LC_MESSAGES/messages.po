msgstr ""
"Žiadny používateľ nemá nastavenú e-mailovú adresu, takže zatiaľ nie je komu "
"poslať."

#: cps/templates/broadcast_email.html
msgid "Send announcement"
msgstr "Odoslať oznámenie"

#: cps/templates/broadcast_email.html
msgid "Send test to me"
msgstr "Poslať test mne"

